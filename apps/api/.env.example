# Copia este archivo como .env y ajusta los valores.
# SQLite guarda transporte.db dentro de apps/api, sin depender
# de la carpeta desde la que se inicie la API.
DATABASE_URL=sqlite:///./transporte.db
# true muestra en consola las consultas SQL que se ejecutan.
DATABASE_ECHO=false
# Autenticación JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Solo se usan para crear el administrador inicial si aún no existe ninguno.
# Usa una contraseña de al menos 12 caracteres y no compartas este archivo.
#ADMIN_EMAIL=admin@example.com
#ADMIN_PASSWORD=una-clave-segura-de-al-menos-12-caracteres
# Cookies de autenticación
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_PATH=/api/v1
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Origen autorizado del frontend
FRONTEND_ORIGIN=http://localhost:5173

# Archivos subidos (comprobantes y documentos). La carpeta es relativa a apps/api
# y no se incluye en Git.
UPLOADS_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Datos de pago que se muestran al comprar. Son de demostración: no uses
# una cuenta bancaria real en el repositorio.
PAYMENT_BANK_NAME=Banco Pichincha
PAYMENT_ACCOUNT_TYPE=Ahorros
PAYMENT_ACCOUNT_NUMBER=2200000000
PAYMENT_ACCOUNT_HOLDER=Transporte Interprovincial (demostración)
PAYMENT_DEUNA_QR=DEMO-DEUNA-TRANSPORTE-INTERPROVINCIAL
