# Copia este archivo como .env y ajusta los valores.
# SQLite crea el archivo transporte.db dentro de apps/api.
DATABASE_URL=sqlite:///./transporte.db
# true muestra en consola las consultas SQL que se ejecutan.
DATABASE_ECHO=false
# Autenticación JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15